# Used by the "Leave a memory" dialog (server/memoryApi.ts). Never exposed to the browser.
OPENAI_API_KEY=
# Optional, defaults to gpt-5-mini
# OPENAI_MODEL=
# Voice for the play buttons (server/speech.ts). Only called when someone presses play.
ELEVENLABS_API_KEY=
# Optional, default to the voice "Brian" (middle-aged man) and eleven_v4
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=
# Optional: model per agent (server/agents.ts). Defaults: gpt-5-mini, gpt-5, gpt-4.1, gpt-5-mini
# DERIVE_MODEL_INTERVIEW=
# DERIVE_MODEL_HISTORIAN=
# DERIVE_MODEL_LITERATURE=
# DERIVE_MODEL_COMPARE=
# Optional: if set, the memory endpoint only answers requests that carry this key (open the site with ?key=… once)
# DERIVE_PASSCODE=

# Used by generate_assets.py
PROJECTSIM_TOKEN=
